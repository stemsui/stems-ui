{
  "name": "stems-ui",
  "version": "0.0.0",
  "description": "Headless, accessible UI primitives for Remix 3",
  "author": "Justin Waite <justindwaite@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stemsui/stems-ui.git",
    "directory": "packages/stems-ui"
  },
  "keywords": [
    "remix",
    "ui",
    "headless",
    "accessible",
    "primitives",
    "base-ui"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test.browser.ts",
    "!src/**/*.test.browser.tsx"
  ],
  "exports": {
    "./separator": {
      "types": "./dist/separator.d.ts",
      "default": "./dist/separator.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "cd ../.. && remix test 'packages/stems-ui/**/*.test{,.browser,.e2e}.{ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@remix-run/component": "^1.1.0"
  },
  "devDependencies": {
    "@remix-run/component": "^1.1.0",
    "@types/node": "^26.6.6",
    "playwright": "^1.64.1",
    "remix": "^3.1.0"
  }
}
